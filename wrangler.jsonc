{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "madhav",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "madhav-seoaves","database_id": "520ce86e-1075-4efd-b2f2-e712c4b55643",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "madhav-seo-aves","preview_bucket_name": "madhav-seo-aves",
		},
	],
	// Worker Loader for plugin sandboxing
	"worker_loaders": [
		{
			"binding": "LOADER",
		},
	],
}
